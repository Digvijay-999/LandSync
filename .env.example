# ==============================================================================
# LANDSYNC AI - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and adjust values for your local development setup.
# Never commit the .env file with sensitive credentials.

# Application Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Backend API Configuration
PROJECT_NAME="LandSync AI"
API_V1_STR=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# PostgreSQL + PostGIS Database Configuration
POSTGRES_SERVER=postgres-postgis
POSTGRES_PORT=5432
POSTGRES_DB=landsync
POSTGRES_USER=landsync
POSTGRES_PASSWORD=landsync_secret_dev_pass

# Database Connection URLs
# Async URL for FastAPI backend with SQLAlchemy + asyncpg
DATABASE_URL=postgresql+asyncpg://landsync:landsync_secret_dev_pass@postgres-postgis:5432/landsync

# Synchronous URL for Alembic migrations and utility scripts
DATABASE_URL_SYNC=postgresql://landsync:landsync_secret_dev_pass@postgres-postgis:5432/landsync

# Frontend Configuration
VITE_API_URL=http://localhost:8000
